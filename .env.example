# ==============================================================================
# Liate — Environment Configuration
# ==============================================================================
# Copy this file to .env to configure your local keys:
#   cp .env.example .env
#
# Liate automatically resolves these keys across all agents and MCP tools.
# ==============================================================================

# [L] Sovereign & Foundational AI Models
# ------------------------------------------------------------------------------
# Sarvam AI (India's Sovereign AI - 105B Reasoning, Bulbul TTS, Saaras STT)
# Sign up at: https://sarvam.ai
SARVAM_API_KEY=""

# Neon AI Gateway (Serverless Branch-Scoped Models: OpenAI, Anthropic, Gemini, Llama)
# Configure at: https://console.neon.tech
NEON_AI_GATEWAY_TOKEN=""
NEON_AI_GATEWAY_BASE_URL="https://api.ai.neon.tech/v1"

# Gnani AI (India's Sovereign Voice & Indic Language AI - Prisma v3.0 STT, Timbre v3.0 TTS)
# Configure at: https://app.gnani.ai / https://api.vachana.ai
GNANI_API_KEY=""
GNANI_BASE_URL="https://api.vachana.ai"

# [T] Tools & MCP Servers (e.g. Cashfree MCP, Custom MCP)
# ------------------------------------------------------------------------------
# CASHFREE_CLIENT_ID=""
# CASHFREE_CLIENT_SECRET=""

# Optional Custom LLMs (OpenAI, Anthropic, or local Ollama)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
