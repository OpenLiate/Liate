{
  "name": "@openliate/liate",
  "version": "0.0.9",
  "description": "India's Open Source AI Agent Framework",
  "type": "module",
  "main": "./dist/liate.js",
  "types": "./src/liate.ts",
  "exports": {
    ".": {
      "types": "./src/liate.ts",
      "import": "./dist/liate.js"
    }
  },
  "bin": {
    "liate": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/liate.js",
    "dist/runtime",
    "src",
    "hub"
  ],
  "scripts": {
    "test": "echo \"Ready for tests\"",
    "build": "bun run build:bin && bun run build:cli && bun run build:runtime && bun run build:hono && bun run build:wasm && bun run build:sdk",
    "build:bin": "bun build ./src/cli/index.ts --target node --format esm --outfile dist/bin.js",
    "build:cli": "bun build ./src/cli/index.ts --compile --outfile dist/cli/liate",
    "build:runtime": "bun build ./src/runtime/hono.ts --target node --format esm --outfile dist/runtime/index.js",
    "build:sdk": "bun build ./src/liate.ts --target node --format esm --outfile dist/liate.js",
    "build:compile": "bun build ./src/liate.ts --compile --outfile dist/liate",
    "compile": "bun run build:compile",
    "serve": "bun run dist/runtime/index.js",
    "typecheck": "tsc --noEmit",
    "build:hono": "bun build ./src/runtime/hono.ts --target bun --format esm --outfile dist/runtime/hono.js",
    "build:wasm": "bun build ./src/runtime/wasm.ts --target bun --format esm --outfile dist/runtime/wasm.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "^4.7.0",
    "jszip": "3.10.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "1.4.4",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "liate",
    "agent",
    "autonomous-agents",
    "sovereign-ai",
    "agent-platform",
    "runtime",
    "mcp"
  ],
  "author": "Vinod Hatti (@gitdevinod)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenLiate/Liate.git"
  },
  "bugs": {
    "url": "https://github.com/OpenLiate/Liate/issues"
  },
  "homepage": "https://openliate.tech"
}